{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/check_closing_handoff.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/check_closing_handoff.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/check_deferred_actions.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/check_deferred_actions.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/post_write_doc_standard_check.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/post_write_doc_standard_check.py\"",
            "timeout": 5
          }
        ],
        "matcher": "^(apply_patch|Write|Edit)$"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/post_write_md_check.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/post_write_md_check.py\"",
            "timeout": 5
          }
        ],
        "matcher": "^(apply_patch|Write)$"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/post_write_memory_gate.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/post_write_memory_gate.py\"",
            "timeout": 5
          }
        ],
        "matcher": "^(apply_patch|Write|Edit)$"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/post_write_principles_read_check.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/post_write_principles_read_check.py\"",
            "timeout": 5
          }
        ],
        "matcher": "^(apply_patch|Write)$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/session_start_load_rules.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/session_start_load_rules.py\"",
            "timeout": 10,
            "additionalContextLimit": 0
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/session_start_selfcheck.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/session_start_selfcheck.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
