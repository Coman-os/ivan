{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/check_closing_handoff.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/check_closing_handoff.py\"",
            "timeout": 15,
            "statusMessage": "Проверка незавершённой работы в конце ответа"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/check_deferred_actions.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/check_deferred_actions.py\"",
            "timeout": 10,
            "statusMessage": "Проверка отложенных обещаний"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/check_request_coverage.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/check_request_coverage.py\"",
            "timeout": 10,
            "statusMessage": "Сверка ответа с поручением"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/post_bash_write_relay.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/post_bash_write_relay.py\"",
            "timeout": 5,
            "statusMessage": "Проверка файлов после правки через терминал"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/post_write_company_documents.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/post_write_company_documents.py\"",
            "timeout": 5,
            "statusMessage": "Проверка документов по правилам компании"
          }
        ],
        "matcher": "^(apply_patch|Write|Edit)$"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/post_write_doc_standard_check.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/post_write_doc_standard_check.py\"",
            "timeout": 5,
            "statusMessage": "Проверка оформления документа"
          }
        ],
        "matcher": "^(apply_patch|Write|Edit)$"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/post_write_md_check.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/post_write_md_check.py\"",
            "timeout": 5,
            "statusMessage": "Проверка шапки и назначения документа"
          }
        ],
        "matcher": "^(apply_patch|Write)$"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/post_write_memory_gate.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/post_write_memory_gate.py\"",
            "timeout": 5,
            "statusMessage": "Проверка места для записи в память"
          }
        ],
        "matcher": "^(apply_patch|Write|Edit)$"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/post_write_principles_read_check.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/post_write_principles_read_check.py\"",
            "timeout": 5,
            "statusMessage": "Проверка чтения принципов перед созданием документа"
          }
        ],
        "matcher": "^(apply_patch|Write)$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/session_start_company_module.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/session_start_company_module.py\"",
            "timeout": 5,
            "statusMessage": "Загрузка правил компании",
            "additionalContextLimit": 0
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/session_start_load_rules.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/session_start_load_rules.py\"",
            "timeout": 10,
            "statusMessage": "Загрузка правил Ивана",
            "additionalContextLimit": 0
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/session_start_selfcheck.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/hooks/session_start_selfcheck.py\"",
            "timeout": 10,
            "statusMessage": "Проверка установки Ивана"
          }
        ]
      }
    ]
  }
}
